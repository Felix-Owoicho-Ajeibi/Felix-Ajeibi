# Environment Variables Example for Felix Ajeibi Portfolio

# VITE_FORMSPREE_ENDPOINT: Optional third-party form handler URL (e.g. Formspree / Web3Forms)
# If left empty, the contact form seamlessly routes inquiries via prefilled WhatsApp and Email client hand-offs.
VITE_FORMSPREE_ENDPOINT=""

# GEMINI_API_KEY: Injected by AI Studio runtime if server-side models are enabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="https://felix-ajeibi-portfolio.vercel.app"
